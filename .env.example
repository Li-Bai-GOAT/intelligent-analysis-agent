# =============================================================================
# 数据分析智能体 - 环境配置示例
# 复制此文件为 .env 并填入实际值
# =============================================================================

# ==================== AI 模型配置 ====================
# 模型提供商选择: deepseek, minimax, openai, anthropic, mimo
MODEL_PROVIDER=mimo
MODEL_TEMPERATURE=0.5
MAX_TOKENS=120000
TOOL_OUTPUT_MAX_LENGTH=8000

# DeepSeek 配置
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_NAME=deepseek-v4-flash

# Mimo 配置（OpenAI 兼容）
MIMO_API_KEY=your-mimo-api-key
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL_NAME=mimo-v2.6-pro
KUNCODE_MODEL=mimo/mimo-v2.6-pro

# MiniMax 配置 (Anthropic API 兼容)
MINIMAX_API_KEY=your-minimax-api-key
MINIMAX_BASE_URL=https://api.minimaxi.com/anthropic
MINIMAX_MODEL_NAME=MiniMax-M2.5

# OpenAI 配置
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_NAME=gpt-4o

# Anthropic 配置
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL_NAME=claude-sonnet-4-20250514

# ==================== 上下文压缩配置 ====================
COMPRESS_THRESHOLD_PERCENT=70
COMPRESS_KEEP_RECENT=10
# 压缩模型配置（可选，留空则使用主模型配置）
COMPRESS_MODEL_PROVIDER=
COMPRESS_MODEL_NAME=

# ==================== Embedding 服务 ====================
EMBEDDING_API_KEY=none
EMBEDDING_BASE_URL=http://localhost:9997/v1
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_ENABLED=true
EMBEDDING_TIMEOUT_SECONDS=120

# ==================== 数据库配置 ====================
# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your-password
DB_NAME=rca_agent
# Existing/shared databases must stay false and be upgraded with Aerich.
# Set true only to initialize a disposable development database.
DB_AUTO_CREATE_SCHEMA=false

# Redis
REDIS_URL=redis://:your-password@localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://:your-password@localhost:6379/1
CELERY_BACKEND_URL=redis://:your-password@localhost:6379/2
CELERY_RESULT_EXPIRES=3600
CELERY_TASK_TIME_LIMIT=1560
CELERY_TASK_SOFT_TIME_LIMIT=1530
TASK_DEADLINE_SECONDS=1500
KUNCODE_TERMINATION_GRACE_SECONDS=5
KUNCODE_TERMINATION_CONFIRM_SECONDS=10

# ==================== 应用服务配置 ====================
APP_HOST=0.0.0.0
APP_PORT=8090
ENVIRONMENT=development
DEBUG=release
CORS_ORIGINS=http://localhost:8090,http://127.0.0.1:8090,http://localhost:5173,http://127.0.0.1:5173

# ==================== 模型调用审计与准入 ====================
MODEL_AUDIT_ENABLED=true
MODEL_AUDIT_LOG_PATH=logs/model-audit/requests.log
MODEL_AUDIT_RETENTION_DAYS=90
ALLOWED_MODEL_PROVIDERS=mimo
ALLOWED_MODEL_NAMES=mimo-v2.6-pro
ALLOWED_KUNCODE_MODELS=mimo/mimo-v2.6-pro
DISABLE_MIMO=false
MAX_REQUEST_TOKENS=200000
DAILY_USER_TOKEN_LIMIT=500000
MODEL_MAX_CONCURRENCY=4

# ==================== 沙箱服务配置 ====================
SANDBOX_BASE_URL=http://localhost:10001
SANDBOX_BEARER_TOKEN=your-sandbox-token
SANDBOX_IDLE_TIMEOUT_SECONDS=7200
SANDBOX_LEASE_SECONDS=1800
SANDBOX_CLEANUP_INTERVAL_SECONDS=300
SANDBOX_MAX_ACTIVE_CONTAINERS=8
SANDBOX_MAX_RELEASE_ATTEMPTS=3
SANDBOX_ORPHAN_GRACE_SECONDS=900
# Keep false during the first rollout. It only affects containers without a
# matching database binding; idle session sandboxes continue to be reclaimed.
SANDBOX_AUTO_RELEASE_ORPHANS=false
SANDBOX_MANAGER_REDIS_URL=redis://:replace-me@localhost:6380/5
SANDBOX_MANAGER_REDIS_DB=5
SANDBOX_MANAGER_POOL_KEY=_runtime_sandbox_container_container_pool:data_analysis
SANDBOX_MANAGER_POOL_SIZE=2
SANDBOX_CONFIG_VERSION=mimo-v2.6

# MCP secret references: database configuration stores {{secret:NAME}}, while
# the actual value lives only in your local .env. Add only explicitly approved
# names to the allowlist, for example: AMAP_MCP_KEY,ANALYTICS_PG_DSN
MCP_SECRET_REFERENCE_ALLOWLIST=
# AMAP_MCP_KEY=
# 默认只暴露 run_kuncode 给外层 Agent；如需调试再打开以下工具
ENABLE_AGENT_PYTHON_TOOL=false
ENABLE_AGENT_SHELL_TOOL=false

# ==================== Milvus 向量数据库 ====================
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=root:Milvus
MILVUS_DATABASE=rca_agent
MILVUS_DIM=1024
MILVUS_COLLECTION=rca_knowledge_base
