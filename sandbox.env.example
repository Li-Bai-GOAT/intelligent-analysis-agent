# AgentScope Runtime Sandbox Server 配置模板
# 首次使用：复制为 sandbox.env，并替换所有 <replace-me> 值。

HOST=0.0.0.0
PORT=10001
WORKERS=2
DEBUG=False
BEARER_TOKEN=<replace-me>

DEFAULT_SANDBOX_TYPE=data_analysis
POOL_SIZE=2
AUTO_CLEANUP=True
CONTAINER_PREFIX_KEY=<replace-me>
CONTAINER_DEPLOYMENT=docker
DEFAULT_MOUNT_DIR=sessions_mount_dir
PORT_RANGE=[49152,59152]

KUNCODE_MODEL=deepseek/deepseek-v4-flash
PYTHONUTF8=1
PYTHONIOENCODING=utf-8
LANG=C.UTF-8
LC_ALL=C.UTF-8
DEEPSEEK_BASE_URL=https://api.deepseek.com

REDIS_ENABLED=True
REDIS_SERVER=localhost
REDIS_PORT=6380
REDIS_DB=5
REDIS_PASSWORD=replace-me

FILE_SYSTEM=local
STORAGE_FOLDER=sessions_mount_dir
